on early-init
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on init
    write /sys/class/backlight/panel0-backlight/brightness 200

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro

on post-fs
    start boot-hal-1-2

on property:twrp.modules.loaded=true && property:dev.mnt.blk.firmware=*
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    start health-hal-2-1

on property:ro.twrp.fastbootd=1
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    start health-hal-2-1

on early-boot
    chown system system /sys/class/leds/vibrator/vmax_mv
    chmod 0600 /sys/class/leds/vibrator/vmax_mv

on boot
    setprop vendor.qcom.vibrator.led.mv_min 1600
    setprop vendor.qcom.vibrator.led.mv_max 3000
    setprop vendor.qcom.vibrator.led.effect_ms_multiplier 10
    setprop vendor.qcom.vibrator.led.enable_effects true
    write /sys/class/leds/vibrator/vmax_mv 3000
    write /sys/class/leds/vibrator/trigger "transient"
    start vendor.qti.hardware.vibrator.service

on property:twrp.modules.loaded=true #Flashlight
    mkdir /tmp/flashlight
    write /tmp/flashlight/max_brightness "1"
    symlink /sys/devices/virtual/camera/factory_test_flash/rear_flash /tmp/flashlight/brightness

service recovery-defaults /sbin/sh /system/bin/recovery-defaults.sh
    class core
    user root
    group root
    oneshot
    disabled

on property:dev.mnt.blk.data=*
    start recovery-defaults
